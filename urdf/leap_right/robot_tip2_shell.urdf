<robot name="onshape">

  <material name="TransparentRed">
    <color rgba="0.9 0 0.2 0.5"/>
  </material>

  <!-- World link -->
  <link name="world"/>
  <!-- Fixed joint anchoring Allegro to world -->
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="palm_lower"/>
    <!-- <origin xyz="0 0 0" rpy="0 3.14 0"/> -->
    <origin xyz="-0.021 0.0355 0" rpy="0 3.14 0"/>

  </joint>

  <!-- =============== LINK: palm_lower =============== -->
